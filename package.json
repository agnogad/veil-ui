{
  "name": "veil-ui",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@veil-ui/docs",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:e2e": "node scripts/e2e-cli.mjs",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint .",
    "format": "prettier --write .",
    "registry:build": "pnpm --filter @veil-ui/registry registry:build",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "oxlint": "^1.0.0",
    "prettier": "^3.4.0",
    "turbo": "^2.5.0",
    "typescript": "^5.9.3"
  }
}
