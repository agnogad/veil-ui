{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://veil-ui.dev/schema.json",
  "title": "Veil UI components.json",
  "type": "object",
  "required": ["style", "tailwind", "aliases"],
  "properties": {
    "$schema": { "type": "string" },
    "style": { "enum": ["default"] },
    "rsc": { "type": "boolean" },
    "tsx": { "type": "boolean" },
    "tailwind": {
      "type": "object",
      "required": ["config", "css", "baseColor", "cssVariables"],
      "properties": {
        "config": { "type": "string" },
        "css": { "type": "string" },
        "baseColor": { "enum": ["neutral"] },
        "cssVariables": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "aliases": {
      "type": "object",
      "required": ["components", "utils", "ui", "lib", "hooks"],
      "properties": {
        "components": { "type": "string" },
        "utils": { "type": "string" },
        "ui": { "type": "string" },
        "lib": { "type": "string" },
        "hooks": { "type": "string" }
      },
      "additionalProperties": false
    },
    "registry": { "type": "string", "format": "uri" }
  },
  "additionalProperties": false
}
